---
const showOutageNote = Boolean(
  process.env.GITHUB_PAGES_BASE && process.env.GITHUB_PAGES_BASE !== "/"
);
---

{
  showOutageNote && (
    <p class="newsletter-outage">
      Newsletter sign-up won't work during the outage caused by the PHP issue of October 21.
    </p>
  )
}

<style>
  .newsletter-outage {
    margin: 0.85rem auto 0;
    max-width: 34rem;
    font-size: 0.95rem;
    line-height: 1.5;
    color: #9a3412;
  }
</style>
