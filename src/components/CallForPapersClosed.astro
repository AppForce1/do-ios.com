---
import stage from "../data/images/location/stage.jpeg";
---

<section id="call-for-papers">
  <h2 class="section-heading">Call for Papers Closed</h2>
  <div class="stage-section">
    <div>
      <figure>
        <blockquote>
          <p>"You (yes, you!) could've looked great on that stage."</p>
        </blockquote>
        <figcaption>—Jeroen Leenarts, <cite>Organizer</cite></figcaption>
      </figure>
    </div>
    <img src={stage.src} alt="The stage of the NEMO Science Museum." />
  </div>

  <p class="description">
    The Call for Papers closed on August 16, 2026. Thank you to everyone who submitted —
    we are reviewing proposals and will announce the remaining lineup soon.
  </p>
</section>
<style>
  h2 {
    margin-bottom: 1rem;
  }

  .stage-section {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: 1rem;
    max-width: 100%;
    overflow: hidden;
    border-radius: 1rem;
    border: 2px solid var(--border-color);
  }

  .stage-section img {
    width: 100%;
  }

  .description {
    font-size: 18px;
    line-height: 28px;
  }

  blockquote {
    font-size: 24px;
    line-height: 36px;
    font-weight: bolder;
    margin: 0;
  }

  @media only screen and (max-width: 600px) {
    .stage-section {
      grid-template-columns: 1fr;
      grid-template-rows: auto 180px;
    }

    .description {
      padding: 0 1rem;
    }
  }
</style>
