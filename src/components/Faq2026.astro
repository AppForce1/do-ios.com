---
const nemoMapsUrl =
  "http://maps.apple.com/?address=Oosterdok+2+Amsterdam&q=NEMO+Science+Museum";

const faqs = [
  {
    question: "When is Do iOS 2026?",
    answer:
      "Do iOS 2026 runs November 10–12, 2026 in Amsterdam. November 10 is the workshop day; November 11 and 12 are the two main conference days with talks and networking.",
  },
  {
    question: "Where is Do iOS 2026 held?",
    answer:
      "The conference takes place at NEMO Science Museum, Oosterdok 2, 1011 VX Amsterdam, in the city centre near Amsterdam Central Station.",
  },
  {
    question: "Can I still submit a talk for Do iOS 2026?",
    answer:
      "The Call for Papers closed on August 16, 2026. Thank you to everyone who submitted. We reviewed proposals and announced the lineup.",
  },
  {
    question: "What is included on the conference days?",
    answer:
      "The conference days include talks at NEMO Science Museum, lunch on both days, and the walking dinner on the first conference evening. November 10 was the workshop day.",
  },
  {
    question: "Is Do iOS an in-person iOS conference?",
    answer:
      "Yes. Do iOS is an in-person iOS developer conference focused on live talks, workshops, and meeting peers in Amsterdam. It has run seven successful editions since 2015.",
  },
  {
    question: "What do I need to bring for the workshops?",
    answer:
      "Bring a Mac laptop with Xcode 27. Daniel Steinberg’s workshop also needs a device you can deploy to using iOS 27 or macOS 27. Peter Friese’s workshop requires a physical iPhone. Workshop activities cannot be completed on a tablet or phone alone.",
  },
  {
    question: "How do I check the schedule during Do iOS?",
    answer:
      "Open do-ios.com/now on your phone to see what is on now and what is next. Add the schedule to Apple Calendar from do-ios.com/schedule.ics so it is still there if the venue Wi-Fi is busy.",
  },
];

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  mainEntity: faqs.map((faq) => ({
    "@type": "Question",
    name: faq.question,
    acceptedAnswer: {
      "@type": "Answer",
      text: faq.answer,
    },
  })),
};
---

<section class="faq" id="faq" aria-labelledby="faq-heading">
  <h2 class="section-heading" id="faq-heading">Frequently Asked Questions</h2>
  <p class="section-lead">
    Everything you need to know about Europe's iOS developer conference in Amsterdam.
  </p>

  <dl class="faq-list">
    <div class="faq-item">
      <dt>{faqs[0].question}</dt>
      <dd>{faqs[0].answer}</dd>
    </div>

    <div class="faq-item">
      <dt>{faqs[1].question}</dt>
      <dd>
        The conference takes place at{" "}
        <a href={nemoMapsUrl}>NEMO Science Museum</a>, Oosterdok 2, 1011 VX
        Amsterdam, in the city centre near Amsterdam Central Station.
      </dd>
    </div>

    <div class="faq-item">
      <dt>{faqs[2].question}</dt>
      <dd>{faqs[2].answer}</dd>
    </div>

    <div class="faq-item">
      <dt>{faqs[3].question}</dt>
      <dd>
        The conference days include talks at{" "}
        <a href={nemoMapsUrl}>NEMO Science Museum</a>, lunch on both days, and
        the walking dinner on the first conference evening. November 10 was the
        workshop day.
      </dd>
    </div>

    <div class="faq-item">
      <dt>{faqs[4].question}</dt>
      <dd>{faqs[4].answer}</dd>
    </div>

    <div class="faq-item">
      <dt>{faqs[5].question}</dt>
      <dd>{faqs[5].answer}</dd>
    </div>

    <div class="faq-item">
      <dt>{faqs[6].question}</dt>
      <dd>
        Open <a href="/now">do-ios.com/now</a> on your phone to see what is on now and what is next.
        <a href="/schedule.ics">Add the schedule to Calendar</a> so it is still there if the venue Wi-Fi is busy.
      </dd>
    </div>
  </dl>
</section>

<script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />

<style>
  .faq-list {
    margin: 1.5rem 0 0;
    padding: 0;
  }

  .faq-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid rgba(15, 23, 42, 0.08);
  }

  .faq-item:last-child {
    border-bottom: none;
    padding-bottom: 0;
  }

  .faq-item dt {
    font-size: 1.125rem;
    font-weight: 700;
    color: var(--text-primary);
    margin: 0 0 0.5rem;
  }

  .faq-item dd {
    margin: 0;
    font-size: 1rem;
    line-height: 1.65;
    color: var(--text-secondary);
  }

  .faq-item dd a {
    color: var(--my-blue);
    font-weight: 600;
    text-decoration: none;
  }

  .faq-item dd a:hover {
    text-decoration: underline;
  }
</style>
